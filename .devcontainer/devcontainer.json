{
  "name": "AWS Examples",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "containerEnv": {
    "AWS_CLI_AUTO_PROMPT": "on-partial"
  },
  "postCreateCommand": "cd $CODESPACE_VSCODE_FOLDER && curl \"https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip\" -o \"awscliv2.zip\" && unzip awscliv2.zip && sudo ./aws/install"
}